---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getPillar } from '../consts';
import RailSpy from '../components/manual/RailSpy.astro';
// 手冊版型樣式（2026-11-10 起全站文章預設）
import '../styles/manual.css';

type NavLink = { slug: string; title: string } | null;
type Props = CollectionEntry<'blog'>['data'] & {
	prev?: NavLink;
	next?: NavLink;
	headings?: MarkdownHeading[];
	readingTime?: number;
	showDate?: boolean;
	ogType?: 'website' | 'article';
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	pillar,
	chapter,
	chapterNum,
	episode,
	tags,
	prev,
	next,
	headings = [],
	readingTime,
	showDate = true,
	ogType = 'article',
	look: lookProp,
} = Astro.props;
// 版型：沒指定就用手冊版型（全站預設）；frontmatter 的 look 保留給日後其他版型
const look = lookProp ?? 'manual';

// 手冊版型：<body id="look-manual">，樣式全部掛在這個 id 底下（styles/manual.css）；首頁、列表頁不用這個 layout，不受影響
const bodyId = look ? `look-${look}` : undefined;
// 手冊版型的字型只在這類文章載入（Noto 繁中由 Google 切片、按需下載）
const MANUAL_FONTS =
	'https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@600;800&family=Noto+Sans+TC:wght@400;500;700&family=IBM+Plex+Mono:wght@500&display=swap';

const pillarInfo = getPillar(pillar);
const epLabel = episode !== undefined ? `EP${String(episode).padStart(2, '0')}` : null;
const chapterLabel = chapter ? (chapterNum && chapterNum > 0 ? `Ch.${chapterNum} ${chapter}` : chapter) : null;
const metaParts = [chapterLabel, epLabel].filter(Boolean);

// 目錄：只取 H2，排除導覽用的「下一篇/上一篇」段落，超過 2 條才顯示（短文不需要）
const NAV_HEADINGS = ['下一篇', '上一篇'];
const toc = headings.filter((h) => h.depth === 2 && !NAV_HEADINGS.includes(h.text.trim()));
const showToc = toc.length >= 3;

// JSON-LD 結構化資料（文章頁才輸出）
const imgURL = heroImage ? new URL(heroImage.src, Astro.site).href : new URL('/og-default.png', Astro.site).href;
const jsonLd =
	ogType === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				image: imgURL,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author: { '@type': 'Person', name: '一人系統' },
				publisher: { '@type': 'Organization', name: '一人系統 Solosystem' },
				mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
			}
		: null;
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} image={heroImage} ogType={ogType} />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		{
			look === 'manual' && (
				<>
					<link rel="preconnect" href="https://fonts.googleapis.com" />
					<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
					<link rel="stylesheet" href={MANUAL_FONTS} />
				</>
			)
		}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 700px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.5em;
				padding: 1em 0 0;
				text-align: left;
				line-height: 1.3;
			}
			.title h1 {
				margin: 0 0 0.4em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.series-meta {
				margin: 0 0 0.4em 0;
				font-size: 0.8em;
				letter-spacing: 0.02em;
			}
			.series-meta a {
				color: rgb(var(--accent));
				text-decoration: none;
				font-weight: 700;
			}
			.series-meta a:hover {
				text-decoration: underline;
			}
			.post-tags {
				margin: 0.8em 0 0 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
			}
			.post-tags .tag {
				font-size: 0.75em;
				color: rgb(var(--gray));
				background: rgb(var(--gray-light));
				padding: 0.12em 0.7em;
				border-radius: 999px;
				text-decoration: none;
				transition: 0.15s ease;
			}
			.post-tags .tag:hover {
				background: rgb(var(--accent));
				color: #fff;
			}
			.hero-image {
				margin: 0 0 2.5em;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-width: 520px;
				height: auto;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.toc {
				margin: 0 0 2.5em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: rgba(var(--gray-light), 25%);
				padding: 0.4em 1.2em;
			}
			.toc summary {
				cursor: pointer;
				font-weight: 700;
				padding: 0.6em 0;
				color: rgb(var(--black));
				list-style: none;
			}
			.toc summary::-webkit-details-marker {
				display: none;
			}
			.toc summary::before {
				content: '＋ ';
				color: rgb(var(--accent));
			}
			.toc[open] summary::before {
				content: '－ ';
			}
			.toc ol {
				margin: 0 0 0.8em;
				padding-left: 1.4em;
			}
			.toc li {
				margin: 0.25em 0;
				line-height: 1.5;
			}
			.toc a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.toc a:hover {
				color: rgb(var(--accent));
				text-decoration: underline;
			}
			.post-nav {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.post-nav-link {
				display: flex;
				flex-direction: column;
				gap: 0.3em;
				max-width: 48%;
				text-decoration: none;
				color: rgb(var(--gray-dark));
			}
			.post-nav-link.next {
				text-align: right;
				margin-left: auto;
			}
			.post-nav-link .dir {
				font-size: 0.8em;
				color: rgb(var(--gray));
			}
			.post-nav-link .t {
				font-weight: 700;
				line-height: 1.4;
			}
			.post-nav-link:hover .t {
				color: rgb(var(--accent));
			}
		</style>
	</head>

	<body id={bodyId}>
		<Header />
		<main>
			<article data-pagefind-body>
				<div class="prose">
					<div class="title">
						{
							(pillarInfo || metaParts.length > 0) && (
								<p class="series-meta">
									{pillarInfo && <a href={`/${pillarInfo.slug}/`}>{pillarInfo.name}</a>}
									{pillarInfo && metaParts.length > 0 && ' · '}
									{metaParts.join(' · ')}
								</p>
							)
						}
						<h1>{title}</h1>
						{
							showDate && (
								<div class="date">
									<FormattedDate date={pubDate} />
									{readingTime && <span> · 約 {readingTime} 分鐘</span>}
									{updatedDate && (
										<div class="last-updated-on">
											最後更新於 <FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)
						}
						{
							tags && tags.length > 0 && (
								<p class="post-tags" data-pagefind-ignore>
									{tags.map((t) => (
										<a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
											#{t}
										</a>
									))}
								</p>
							)
						}
						<hr />
					</div>

					{
						heroImage && (
							<div class="hero-image">
								<Image
									src={heroImage}
									alt={title}
									widths={[360, 520, 760, 1040]}
									sizes="(max-width: 720px) 90vw, 520px"
									loading="eager"
									fetchpriority="high"
								/>
							</div>
						)
					}

					{
						showToc && (
							<details class="toc" open data-pagefind-ignore>
								<summary>目錄</summary>
								<ol>
									{toc.map((h) => (
										<li>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
							</details>
						)
					}

					<slot />
					{
						(prev || next) && (
							<nav class="post-nav" data-pagefind-ignore>
								{prev ? (
									<a class="post-nav-link prev" href={`/blog/${prev.slug}/`}>
										<span class="dir">← 上一篇</span>
										<span class="t">{prev.title}</span>
									</a>
								) : (
									<span />
								)}
								{next ? (
									<a class="post-nav-link next" href={`/blog/${next.slug}/`}>
										<span class="dir">下一篇 →</span>
										<span class="t">{next.title}</span>
									</a>
								) : (
									<span />
								)}
							</nav>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
		{look === 'manual' && <RailSpy />}
	</body>
</html>
