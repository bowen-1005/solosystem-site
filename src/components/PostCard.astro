---
import type { CollectionEntry } from 'astro:content';
import { getPillar } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const d = post.data;
const pillar = getPillar(d.pillar);

const epLabel = d.episode !== undefined ? `EP${String(d.episode).padStart(2, '0')}` : null;
const chapterLabel = d.chapter
	? d.chapterNum && d.chapterNum > 0
		? `Ch.${d.chapterNum} ${d.chapter}`
		: d.chapter
	: null;

const metaParts = [pillar?.name, chapterLabel, epLabel].filter(Boolean);
---

<article class="card">
	<a class="card-body" href={`/blog/${post.id}/`}>
		{metaParts.length > 0 && <p class="meta">{metaParts.join(' · ')}</p>}
		<h3 class="title">{d.title}</h3>
		{d.description && <p class="excerpt">{d.description}</p>}
		<p class="date"><FormattedDate date={d.pubDate} /></p>
	</a>
	{
		d.tags && d.tags.length > 0 && (
			<p class="tags">
				{d.tags.map((t) => (
					<a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>
						#{t}
					</a>
				))}
			</p>
		)
	}
</article>

<style>
	.card {
		background: var(--surface);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1em 1.2em;
		margin: 0 0 0.8em;
		transition: border-color 0.2s ease;
	}
	.card:hover {
		border-color: var(--accent);
	}
	.card-body {
		display: block;
		text-decoration: none;
		transition: 0.2s ease;
	}
	.meta {
		margin: 0 0 0.3em 0;
		font-family: var(--f-mono);
		font-size: 0.72em;
		letter-spacing: 0.08em;
		color: var(--accent);
	}
	.title {
		margin: 0 0 0.3em 0;
		font-family: var(--f-display);
		font-size: 1.2em;
		font-weight: 800;
		line-height: 1.45;
		color: rgb(var(--black));
	}
	.excerpt {
		margin: 0 0 0.4em 0;
		font-size: 0.9em;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.date {
		margin: 0;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.tags {
		margin: 0.5em 0 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.tag {
		font-size: 0.72em;
		color: rgb(var(--gray));
		background: var(--surface);
		border: 1px solid rgb(var(--gray-light));
		padding: 0.1em 0.6em;
		border-radius: 999px;
		text-decoration: none;
		transition: 0.15s ease;
	}
	.tag:hover {
		background: var(--accent);
		color: #fff;
	}
	.card-body:hover .title {
		color: var(--accent);
	}
</style>
