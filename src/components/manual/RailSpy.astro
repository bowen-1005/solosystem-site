---
// 手冊版型的目錄：寬螢幕時固定在左側，捲動時標出目前讀到的章節
---
<script>
	const links = new Map<string, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((a) => {
		links.set(decodeURIComponent(a.getAttribute('href')!.slice(1)), a);
	});
	if (links.size) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					const a = links.get((e.target as HTMLElement).id);
					if (!a) continue;
					links.forEach((x) => x.classList.remove('is-active'));
					a.classList.add('is-active');
				}
			},
			{ rootMargin: '0px 0px -75% 0px' }
		);
		document.querySelectorAll<HTMLElement>('.prose h2[id]').forEach((h) => io.observe(h));
	}
</script>
