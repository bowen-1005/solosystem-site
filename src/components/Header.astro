---
import { PILLARS, SITE_TITLE, seriesOfPillar } from '../consts';
import HeaderLink from './HeaderLink.astro';

// 分類選單：主軸（已連載）→ 底下掛該主軸的系列
const navGroups = PILLARS.filter((p) => p.active)
	.sort((a, b) => a.order - b.order)
	.map((pillar) => ({ pillar, series: seriesOfPillar(pillar.key) }));
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首頁</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<details class="dropdown">
				<summary>分類 ▾</summary>
				<div class="dropdown-menu">
					{
						navGroups.map(({ pillar, series }) => (
							<div class="dd-group">
								<a class="dd-pillar" href={`/${pillar.slug}/`}>
									{pillar.name}
								</a>
								{series.map((s) => (
									<a class="dd-series" href={`/series/${s.slug}/`}>
										{s.name}
									</a>
								))}
							</div>
						))
					}
				</div>
			</details>
			<HeaderLink href="/about">關於</HeaderLink>
			<HeaderLink href="/contact">聯絡</HeaderLink>
		</div>
		<div class="social-links">
			<a href="/rss.xml" target="_blank">
				<span class="sr-only">訂閱 RSS</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2zm1.5 2.5c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1 0-2zm0 4a6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1 0-2zm.5 5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<script>
	// 點擊選單以外的地方時，收起「系列」下拉（原生 <details> 不會自動關）
	document.addEventListener('click', (e) => {
		const dd = document.querySelector('details.dropdown');
		if (dd && dd.hasAttribute('open') && !dd.contains(e.target as Node)) {
			dd.removeAttribute('open');
		}
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	/* 系列下拉：用原生 <details>，桌機點擊、手機點按都可用（不再依賴 hover） */
	.dropdown {
		position: relative;
	}
	.dropdown summary {
		list-style: none;
		cursor: pointer;
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		user-select: none;
	}
	.dropdown summary::-webkit-details-marker {
		display: none;
	}
	.dropdown[open] summary {
		color: rgb(var(--accent));
	}
	.dropdown-menu {
		position: absolute;
		top: 100%;
		left: 0;
		min-width: 10em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 12%);
		border-radius: 0 0 8px 8px;
		z-index: 10;
	}
	.dropdown-menu a {
		display: block;
		padding: 0.6em 1em;
		border-bottom: none;
		white-space: nowrap;
	}
	.dropdown-menu a:hover {
		background: rgb(var(--gray-light));
		color: rgb(var(--accent));
	}
	/* 主軸＝粗體群組標題；系列＝縮排在主軸底下 */
	.dd-group + .dd-group {
		border-top: 1px solid rgb(var(--gray-light));
	}
	.dropdown-menu a.dd-pillar {
		font-weight: 700;
	}
	.dropdown-menu a.dd-series {
		padding: 0.4em 1em 0.4em 1.8em;
		font-size: 0.92em;
		color: rgb(var(--gray-dark));
	}
	@media (max-width: 720px) {
		nav {
			justify-content: center;
			padding: 0.2em 0;
		}
		h2 {
			width: 100%;
			text-align: center;
			padding: 0.6em 0 0.1em;
			font-size: 1.05em;
		}
		.internal-links {
			flex-wrap: wrap;
			justify-content: center;
		}
		nav a,
		.dropdown summary {
			padding: 0.55em 0.6em;
		}
		/* 手機上讓下拉選單置中對齊觸發鈕，避免超出畫面右緣 */
		.dropdown-menu {
			left: 50%;
			transform: translateX(-50%);
			max-width: 90vw;
		}
		.social-links {
			display: none;
		}
	}
</style>
