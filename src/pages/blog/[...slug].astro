---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { filterPublished, prevNextGlobal } from '../../series';

export async function getStaticPaths() {
	const posts = filterPublished(await getCollection('blog'));
	return posts.map((post) => {
		const { prev, next } = prevNextGlobal(posts, post);
		const lite = (p: CollectionEntry<'blog'> | null) =>
			p ? { slug: p.id, title: p.data.title } : null;
		return {
			params: { slug: post.id },
			props: { post, prev: lite(prev), next: lite(next) },
		};
	});
}
type Props = {
	post: CollectionEntry<'blog'>;
	prev: { slug: string; title: string } | null;
	next: { slug: string; title: string } | null;
};

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

// 預估閱讀時間：中文約每分鐘 400 字（去掉 markdown 標記後粗估；MDX 另外去掉 import 行與元件標籤）
const body = post.body ?? '';
const prose = post.filePath?.endsWith('.mdx')
	? body.replace(/^import .*$/gm, '').replace(/<\/?[A-Z][^>]*>/g, '')
	: body;
const plain = prose.replace(/[#>*`_~\-\[\]()!|]/g, '');
const readingTime = Math.max(1, Math.round(plain.length / 400));
---

<BlogPost {...post.data} prev={prev} next={next} headings={headings} readingTime={readingTime}>
	<Content />
</BlogPost>
